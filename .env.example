APP_NAME="CRM Habitacao Publica"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
MVHAB_SEED_STATE_OF_ART_DEMO=false
MVHAB_REGULATORY_DEMO_MODE=false
MVHAB_MUNICIPAL_APPLICATION_DEMO=false
MVHAB_DEMO_REFERENCE_DATE=
MVHAB_DEMO_USER_PASSWORD=
MVHAB_E2E_USER_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_habitacao_publica
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
MVHAB_CANDIDATE_NOTIFICATION_PREFERENCES_ENABLED=false
MVHAB_LEGACY_CANDIDATE_VISITS_ENABLED=false
MVHAB_TENANT_SUPPORT_ENABLED=true
MVHAB_PROCEDURAL_EMAIL_QUEUE=communications
MVHAB_PROCEDURAL_EMAIL_SIMULATE=false

MVHAB_MUNICIPAL_ADMIN_INVITATION_QUEUE=notifications

# Cloudflare Turnstile — login (disabled by default)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=hab.microvida.pt
TURNSTILE_LOGIN_ACTION=login
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT=5

# Auth rate limits
MVHAB_AUTH_LOGIN_SUBMISSION_ATTEMPTS=20
MVHAB_AUTH_LOGIN_SUBMISSION_DECAY_MINUTES=1
MVHAB_AUTH_LOGIN_CREDENTIAL_ATTEMPTS=5
MVHAB_AUTH_LOGIN_CREDENTIAL_DECAY_SECONDS=60
MVHAB_AUTH_REGISTRATION_IP_ATTEMPTS=5
MVHAB_AUTH_REGISTRATION_IP_DECAY_MINUTES=10
MVHAB_AUTH_REGISTRATION_EMAIL_ATTEMPTS=3
MVHAB_AUTH_REGISTRATION_EMAIL_DECAY_MINUTES=60
MVHAB_AUTH_PASSWORD_RESET_IP_ATTEMPTS=5
MVHAB_AUTH_PASSWORD_RESET_IP_DECAY_MINUTES=10
MVHAB_AUTH_PASSWORD_RESET_EMAIL_ATTEMPTS=3
MVHAB_AUTH_PASSWORD_RESET_EMAIL_DECAY_MINUTES=10
MVHAB_AUTH_VERIFICATION_RESEND_ATTEMPTS=6
MVHAB_AUTH_VERIFICATION_RESEND_DECAY_MINUTES=1

# Public visit Turnstile
MVHAB_PUBLIC_VISITS_TURNSTILE_ENABLED=false
MVHAB_PUBLIC_VISITS_TURNSTILE_SITE_KEY=
MVHAB_PUBLIC_VISITS_TURNSTILE_SECRET_KEY=
MVHAB_PUBLIC_VISITS_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
MVHAB_PUBLIC_VISITS_TURNSTILE_TIMEOUT=5
MVHAB_PUBLIC_VISITS_TURNSTILE_EXPECTED_HOSTNAME=hab.microvida.pt
MVHAB_PUBLIC_VISITS_TURNSTILE_ACTION=public_visit
