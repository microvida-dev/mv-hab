{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:mvhab:application-results:v1",
    "title": "MV HAB - Resultados temporais de candidaturas",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "export", "applications", "documents", "findings", "changes"],
    "properties": {
        "schema_version": {"const": "1.0"},
        "export": {"$ref": "#/$defs/export"},
        "applications": {"type": "array", "items": {"$ref": "#/$defs/application"}},
        "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}
    },
    "$defs": {
        "export": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version", "export_public_id", "generated_at", "snapshot_at",
                "municipality_code", "contest_code", "mode", "official", "source_type",
                "source_references", "source_fingerprint", "formats", "datasets",
                "sensitive_fields_included", "document_files_requested", "csv_configuration", "counts"
            ],
            "properties": {
                "schema_version": {"const": "1.0"},
                "export_public_id": {"type": "string", "minLength": 1},
                "generated_at": {"type": "string", "format": "date-time"},
                "snapshot_at": {"type": "string", "format": "date-time"},
                "municipality_code": {"type": "string", "minLength": 1},
                "contest_code": {"type": "string", "minLength": 1},
                "mode": {"enum": ["current_state", "sealed_batch", "phase_snapshot", "delta_between_batches", "delta_since_datetime", "final_result"]},
                "official": {"type": "boolean"},
                "source_type": {"type": "string", "minLength": 1},
                "source_references": {"type": "object"},
                "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "formats": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"enum": ["csv", "json", "xml", "xlsx"]}
                },
                "datasets": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"enum": ["applications", "documents", "findings", "changes"]}
                },
                "sensitive_fields_included": {"type": "boolean"},
                "document_files_requested": {"type": "boolean"},
                "csv_configuration": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["delimiter", "bom"],
                    "properties": {
                        "delimiter": {"enum": [",", ";", "tab"]},
                        "bom": {"type": "boolean"}
                    }
                },
                "counts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["applications", "documents", "findings", "changes"],
                    "properties": {
                        "applications": {"type": "integer", "minimum": 0},
                        "documents": {"type": "integer", "minimum": 0},
                        "findings": {"type": "integer", "minimum": 0},
                        "changes": {"type": "integer", "minimum": 0}
                    }
                }
            }
        },
        "application": {
            "type": "object",
            "additionalProperties": false,
            "required": ["municipality_code", "contest_code", "snapshot_at", "source_fingerprint"],
            "properties": {
                "municipality_code": {"type": "string"},
                "contest_code": {"type": "string"},
                "contest_public_id": {"type": ["string", "null"]},
                "phase_code": {"type": ["string", "null"]},
                "batch_public_id": {"type": ["string", "null"]},
                "batch_cycle": {"type": ["string", "null"]},
                "batch_sequence": {"type": ["integer", "null"]},
                "snapshot_at": {"type": "string"},
                "published_at": {"type": ["string", "null"]},
                "application_number": {"type": ["string", "null"]},
                "process_number": {"type": ["string", "null"]},
                "candidate_name": {"type": ["string", "null"]},
                "submission_status_code": {"type": ["string", "null"]},
                "submission_status_label": {"type": ["string", "null"]},
                "review_status_code": {"type": ["string", "null"]},
                "review_status_label": {"type": ["string", "null"]},
                "review_result_code": {"type": ["string", "null"]},
                "review_result_label": {"type": ["string", "null"]},
                "documents_required": {"type": ["integer", "null"]},
                "documents_valid": {"type": ["integer", "null"]},
                "documents_missing": {"type": ["integer", "null"]},
                "documents_invalid": {"type": ["integer", "null"]},
                "correction_required": {"type": ["boolean", "null"]},
                "correction_deadline": {"type": ["string", "null"]},
                "correction_submitted_at": {"type": ["string", "null"]},
                "revalidation_result_code": {"type": ["string", "null"]},
                "eligibility_status_code": {"type": ["string", "null"]},
                "eligibility_status_label": {"type": ["string", "null"]},
                "score_status_code": {"type": ["string", "null"]},
                "score_status_label": {"type": ["string", "null"]},
                "final_administrative_status_code": {"type": ["string", "null"]},
                "final_administrative_status_label": {"type": ["string", "null"]},
                "last_changed_at": {"type": ["string", "null"]},
                "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
        },
        "document": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_instance", "carried_forward"],
            "properties": {
                "application_number": {"type": ["string", "null"]},
                "process_number": {"type": ["string", "null"]},
                "required_document_code": {"type": ["string", "null"]},
                "document_type_code": {"type": ["string", "null"]},
                "target_type": {"type": ["string", "null"]},
                "target_reference": {"type": ["string", "null"]},
                "requirement_instance": {"type": "integer"},
                "required_submissions": {"type": ["integer", "null"]},
                "reference_period": {"type": ["string", "null"]},
                "document_status_code": {"type": ["string", "null"]},
                "version_number": {"type": ["integer", "null"]},
                "submitted_at": {"type": ["string", "null"]},
                "validated_at": {"type": ["string", "null"]},
                "source_sha256": {"type": ["string", "null"]},
                "carried_forward": {"type": "boolean"},
                "source_batch_public_id": {"type": ["string", "null"]}
            }
        },
        "finding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_code", "carried_forward"],
            "properties": {
                "application_number": {"type": ["string", "null"]},
                "finding_code": {"type": "string"},
                "requirement_code": {"type": ["string", "null"]},
                "finding_status_code": {"type": ["string", "null"]},
                "finding_status_label": {"type": ["string", "null"]},
                "decision_code": {"type": ["string", "null"]},
                "carried_forward": {"type": "boolean"},
                "source_batch_public_id": {"type": ["string", "null"]},
                "decided_at": {"type": ["string", "null"]},
                "resolved_at": {"type": ["string", "null"]}
            }
        },
        "change": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_type", "entity_reference", "change_type", "sensitive_value_redacted"],
            "properties": {
                "entity_type": {"type": "string"},
                "entity_reference": {"type": "string"},
                "application_number": {"type": ["string", "null"]},
                "change_type": {"enum": ["added", "removed", "changed", "unchanged"]},
                "field_code": {"type": ["string", "null"]},
                "before_value": {},
                "after_value": {},
                "before_source": {"type": ["string", "null"]},
                "after_source": {"type": ["string", "null"]},
                "changed_at": {"type": ["string", "null"]},
                "sensitive_value_redacted": {"type": "boolean"}
            }
        }
    }
}
